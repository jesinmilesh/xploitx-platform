# ==============================================================================
# XploitX CTF Platform - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and fill in the values.
# NEVER commit the actual .env file or real secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments, or 'development' / 'testing'
ENVIRONMENT=production

# Cryptographically strong secret key used for session signing and CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_char_hex_key

# Reverse proxy setting. Set to true if behind Nginx / Cloudflare / Caddy.
# Or specify comma-separated ProxyFix levels: x_for,x_proto,x_host,x_port,x_prefix
REVERSE_PROXY=true

# Number of Gunicorn worker processes (Recommended: 2 x CPU cores + 1)
WORKERS=4

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (PostgreSQL or MariaDB Recommended)
# ------------------------------------------------------------------------------
# Production connection URI.
# Examples:
#   PostgreSQL: postgresql://ctfd:ctfd_password@db:5432/ctfd
#   MariaDB/MySQL: mysql+pymysql://ctfd:ctfd_password@db:3306/ctfd?charset=utf8mb4
DATABASE_URL=postgresql://ctfd:secure_db_password@postgres:5432/ctfd

# Connection pooling settings
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_PRE_PING=true
SQLALCHEMY_TRACK_MODIFICATIONS=false

# ------------------------------------------------------------------------------
# 3. CACHE & REAL-TIME STATE (Redis)
# ------------------------------------------------------------------------------
# Redis connection URL for session storage, caching, rate limiting, and SSE
REDIS_URL=redis://:secure_redis_password@cache:6379/0

# ------------------------------------------------------------------------------
# 4. HTTP SECURITY & COOKIE SETTINGS
# ------------------------------------------------------------------------------
# Enforce HTTPS-only cookies in production (must be true for HTTPS deployments)
SESSION_COOKIE_SECURE=true

# Prevent client-side JS from accessing session cookies (mitigate XSS session theft)
SESSION_COOKIE_HTTPONLY=true

# SameSite cookie protection: Lax or Strict
SESSION_COOKIE_SAMESITE=Lax

# Session expiration time in seconds (604800 = 7 days)
PERMANENT_SESSION_LIFETIME=604800

# Allowed Host headers (comma-separated list of hostnames or wildcard subdomains)
# Example: ctf.xploitx.org,.xploitx.org,localhost
TRUSTED_HOSTS=ctf.xploitx.org,localhost

# Allowed CORS origins (comma-separated, no wildcards in production)
CORS_ALLOWED_ORIGINS=https://ctf.xploitx.org

# ------------------------------------------------------------------------------
# 5. EMAIL / SMTP / NOTIFICATIONS
# ------------------------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USEAUTH=true
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_TLS=true
MAIL_SSL=false
MAILFROM_ADDR=noreply@xploitx.org
MAILSENDER_ADDR=noreply@xploitx.org
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 6. FILE STORAGE & UPLOADS
# ------------------------------------------------------------------------------
# Provider: 'filesystem' or 's3'
UPLOAD_PROVIDER=filesystem
UPLOAD_FOLDER=/var/uploads

# S3 Configuration (Required if UPLOAD_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 7. ISOLATED CHALLENGE INSTANCE MANAGER
# ------------------------------------------------------------------------------
# URL of the isolated Instance Manager daemon (running on dedicated Docker host)
INSTANCE_MANAGER_URL=http://instance-manager:9000

# Shared secret HMAC token for authenticated communication with Instance Manager
INSTANCE_MANAGER_SECRET=replace_with_a_secure_instance_manager_secret

# Instance lifecycle rules
CONTAINER_MAX_LIFETIME_MINUTES=30
CONTAINER_MEM_LIMIT=256m
CONTAINER_CPU_LIMIT=0.5
CONTAINER_PIDS_LIMIT=100

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & ABUSE PROTECTION
# ------------------------------------------------------------------------------
RATELIMIT_DEFAULT=100/minute
RATELIMIT_LOGIN=10/minute
RATELIMIT_REGISTER=5/minute
RATELIMIT_FLAG_SUBMIT=15/minute
RATELIMIT_INSTANCE_CREATE=3/minute

# ------------------------------------------------------------------------------
# 9. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_FOLDER=/var/log/CTFd
ACCESS_LOG=-
ERROR_LOG=-
